; -----------------------------------------------------------------------------
; fifoRead - monitor the CSR pin and send either status or data value
;
;           due to the read-ahead nature of the TMS9918, we have the 
;           possible read values already. Each tx FIFO word contains
;           the current values for status, read data and pin direction
;
; fifo osr  0b|xxxxxxxx|ssssssss|dddddddd|11111111|
;             | ignore | status |  data  | pindir |
;
; fifo isr  0b|m|w|r|
;             |o|r|e|
;             |d|i|a|
;             |e|t|d|
;             | |e| |
;

.program fifoRead
.define public CSR_PIN 26
;.side_set 1 opt
.wrap_target
start:
  mov osr, null       ; change CD0-7 pindirs to inputs
  out pindirs, 8; side 1

  wait 0 gpio CSR_PIN ; wait for CSR to go low (active)
  jmp pin readStatus  ; if PIN_A0_28 'mode' is high, read status bits 
readData:
  ;mov x, null
  ;set x,0x15
  pull noblock
  out pins, 8         ; mode is low, send the data byte
  jmp endPart
readStatus:
  mov x, STATUS
  jmp !x, l02
  set x, 1
l02:
  mov osr, x
  out pins, 8       ; output the status byte (1 - is busy)
endPart:
  mov osr, !null
  out pindirs, 8; side 1   ; set up CD0-7 as outputs
  wait 1 gpio CSR_PIN ; wait for CSR to go high (inactive) 
.wrap

.program rom
.define public PIN_nCS2 23
.define public PIN_nWR 6
.side_set 1 opt
  pull block
  mov x,osr
.wrap_target
  mov osr, null       ; change CD0-7 pindirs to inputs
  out pindirs, 8 side 1
  wait 0 gpio PIN_nCS2
  pull noblock
  mov x,OSR
  jmp pin, romRead ; PIN_nWR
  wait 1 gpio PIN_nWR
  jmp s1
rr01:
  out null, 8
  jmp loop0
romRead:
  mov isr, null
  out pindirs, 8 side 0   ; set up CD0-7 as outputs
rpt01:
  in pins, 2

  mov y, isr
  ;jmp !y, rpt01
loop0:
  jmp y--, rr01
  out pins, 8
s1:
  in pins, 26;14+8+4
  push noblock

  wait 1 gpio PIN_nCS2
.wrap

.program rom2
;.define public PIN_nCS2 23
.define public PIN_nRD 5
.side_set 1 opt
.wrap_target
  mov osr, null       ; change CD0-7 pindirs to inputs
  out pindirs, 8 side 1
  wait 0 gpio PIN_nRD
  mov OSR, !null
  out pindirs, 8 side 0   ; set up CD0-7 as outputs
  out pins, 8
  wait 1 gpio PIN_nRD
.wrap

.program dmaRead
.define public nDACK_PIN 5
.define public nIOR_PIN  3
.side_set 1 opt
.wrap_target
  mov osr, null       ; change CD0-7 pindirs to inputs
  out pindirs, 8 side 1

  wait 1 gpio nDACK_PIN ; wait for nDACK_PIN to go inactive (high)
  ;set pins, 1
  wait 0 gpio nDACK_PIN ; wait for nDACK to go active (low)
  wait 0 gpio nIOR_PIN  ; wait for nIOR to go active (low)
  pull block
  out pins, 8           ; send the data byte
  out pindirs, 8 side 0 ; set up CD0-7 as outputs
  ;set pins, 0           ; reset wait trigger
  wait 1 gpio nIOR_PIN ; wait for nIOR_PIN to go inactive (high)
.wrap

; -----------------------------------------------------------------------------
; fifoWrite - monitor the CSW pin and pass on pin state via FIFO
;           
;            very simple grab the data and send it through...
;
; fifo isr   0b|x|m|w|r|xxxx|dddddddd|
;              | |o|r|e|    |  CD0-7 |
;              | |d|i|a|    |        |
;              | |e|t|d|    |        |
;              | | |e| |    |        |

.program fifoWrite
.define public CSW_PIN 27

  wait 0 gpio CSW_PIN ; wait for CSW to go active (low)
  wait 1 gpio CSW_PIN ; wait for CSW high (inactive)
  in pins, 16                ; grab the data CD0-7 and auto-push
.wrap

.program dmaWrite
.define public nDACK_PIN 5
.define public nIOW_PIN  0
  wait 0 gpio nDACK_PIN ; wait for nDACK to go active (low)
  wait 0 gpio nIOW_PIN  ; wait for nIOW to go active (low)
  ;set pins, 0           ; reset wait trigger
  wait 1 gpio nIOW_PIN  ; wait for nIOW high (inactive)
  in pins, 16           ; grab the data CD0-7 and auto-push
  wait 1 gpio nDACK_PIN ; wait for nDACK_PIN to go inactive (high)
  ;set pins, 1
.wrap

